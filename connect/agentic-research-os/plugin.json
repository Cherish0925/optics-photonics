{
  "name": "optics-photonics",
  "version": "0.7.0",
  "description": "Optical research environment: solvers, native programs and episode sampling",
  "skills": [
    "skills/optical-computation",
    "skills/optical-research"
  ],
  "mcpServers": {
    "optics": {
      "transport": "stdio",
      "command": "${RESEARCH_PYTHON}",
      "args": [
        "-B",
        "${PACKAGE_ROOT}/server.py",
        "mcp"
      ],
      "protocol_version": "2025-11-25"
    }
  }
}
