{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Cherish0925/optics-photonics/main/data/schema.json",
  "title": "Optics Photonics Catalogue v1",
  "description": "Each locale is an array. IDs, classifications and source URLs are shared across locales. unverified does not mean absent.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "method",
      "summary",
      "api",
      "license",
      "compute",
      "usage",
      "limit",
      "stage",
      "group",
      "route",
      "cats",
      "sources",
      "mcp",
      "skill"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "method": {
        "type": "string",
        "minLength": 1
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "api": {
        "type": "string",
        "minLength": 1
      },
      "license": {
        "type": "string",
        "minLength": 1
      },
      "compute": {
        "type": "string",
        "minLength": 1
      },
      "usage": {
        "type": "string",
        "minLength": 1
      },
      "limit": {
        "type": "string",
        "minLength": 1
      },
      "stage": {
        "type": "string",
        "minLength": 1
      },
      "group": {
        "enum": [
          "paid",
          "open",
          "limited"
        ]
      },
      "route": {
        "enum": [
          "api",
          "script",
          "gui"
        ]
      },
      "cats": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "ray",
            "wave",
            "em",
            "periodic",
            "film",
            "pic",
            "fiber",
            "laser",
            "scatter",
            "quantum",
            "bio",
            "xray",
            "imaging",
            "foundation"
          ]
        }
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "label",
            "url"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false
        }
      },
      "mcp": {
        "type": "object",
        "required": [
          "kind",
          "text"
        ],
        "properties": {
          "kind": {
            "enum": [
              "official",
              "community",
              "unverified"
            ]
          },
          "text": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      },
      "skill": {
        "type": "object",
        "required": [
          "kind",
          "text"
        ],
        "properties": {
          "kind": {
            "enum": [
              "official",
              "community",
              "unverified"
            ]
          },
          "text": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
